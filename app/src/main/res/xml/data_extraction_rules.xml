<?xml version="1.0" encoding="utf-8"?>
<!--
   Nooki promises that nothing leaves the phone, so app data stays out of cloud backup. A direct
   phone-to-phone transfer stays allowed, because that is the person moving their own data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
</data-extraction-rules>
