# Copy to keystore.properties (git-ignored) and fill in. Used by app/build.gradle.kts for
# locally signed release APKs. Environment variables KEYSTORE_PATH / STORE_PASSWORD /
# KEY_ALIAS / KEY_PASSWORD take precedence when set.
#
# Create the keystore once (keep it and the passwords safe: losing them means you can't
# ship updates that install over the old APK):
#   keytool -genkeypair -v -keystore nooki-release.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=nooki-release.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
